---
import '../styles/global.css';
import { brand } from '../content/copy';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${brand.name} — ${brand.taglinePrimary}`,
  description = brand.taglinePivot,
  ogImage = '/og.png',
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://nothing.example.com';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Favicon is intentionally a transparent icon. The joke. -->
    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="absolute top-0 left-0 right-0 z-20">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 md:px-10 py-6">
        <a href="/" class="font-display text-lg font-bold tracking-tight">
          {brand.navWordmark}
        </a>
        <div class="hidden gap-7 text-sm text-bone-200/70 md:flex">
          <a href="/#diy" class="hover:text-bone-50 transition">Make one</a>
          <a href="/story" class="hover:text-bone-50 transition">Story</a>
          <a href="/#faq" class="hover:text-bone-50 transition">FAQ</a>
          <a href="/press" class="hover:text-bone-50 transition">Press</a>
        </div>
        <a href="/#diy" class="btn-accent text-sm px-5 py-2.5">Get the plans</a>
      </nav>
    </header>

    <main class="pt-20">
      <slot />
    </main>

    <Footer />
  </body>
</html>
