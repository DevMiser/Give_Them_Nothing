---
import { hero, brand } from '../content/copy';
---
<section class="relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 md:px-10 pt-10 md:pt-20 pb-16 grid gap-12 md:grid-cols-2 md:items-center">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 class="h-display mt-4">{hero.headline}</h1>
      <p class="mt-6 text-2xl md:text-3xl font-display text-bone-50 leading-snug">
        {hero.subheadline}
      </p>
      <p class="mt-2 text-sm text-bone-200/60">*{hero.footnote}</p>
      <p class="mt-8 text-bone-200/80 max-w-md">
        {hero.kickstarterNote}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href={hero.primaryCtaHref} class="btn-accent">{hero.primaryCta}</a>
        <a href={hero.secondaryCtaHref} class="btn-ghost">{hero.secondaryCta}</a>
      </div>
      <p class="mt-4 text-xs text-bone-200/50">{hero.ctaSubtext}</p>
    </div>

    <div class="relative w-full max-w-xl mx-auto rounded-3xl overflow-hidden border border-bone-200/10 bg-charcoal-900 p-4 md:p-6">
      <img
        src="/images/the-nothing-project.png"
        alt="The NOTHING. box, matte charcoal with white printing, next to a folded Owner's Manual."
        class="w-full h-auto object-contain"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
