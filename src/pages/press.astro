---
import Base from '../layouts/Base.astro';
import { press } from '../content/copy';
---
<Base title="Press — The Nothing Project" description="Press kit for The Nothing Project.">
  <article class="section max-w-3xl">
    <span class="eyebrow">Press</span>
    <h1 class="h-section mt-4">{press.heading}</h1>
    <p class="mt-6 prose-bone text-lg">{press.intro}</p>

    <h2 class="font-display text-2xl mt-12">One-liner</h2>
    <p class="mt-3 prose-bone italic border-l-2 border-accent pl-5">{press.oneLiner}</p>

    <h2 class="font-display text-2xl mt-12">Assets</h2>
    <ul class="mt-3 space-y-2">
      {press.assets.map((a) => (
        <li>
          <a href={a.href} download class="text-accent hover:underline">↓ {a.label}</a>
        </li>
      ))}
    </ul>
  </article>
</Base>
