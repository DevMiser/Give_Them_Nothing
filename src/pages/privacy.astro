---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy — NOTHING.">
  <article class="section max-w-3xl prose-bone">
    <h1 class="h-section mb-8">Privacy Policy</h1>

    <h2 class="font-display text-2xl mt-10 text-bone-50">What we collect</h2>
    <p class="mt-3">Optional: the email address you submit to our newsletter, and photos you submit to the "Nothing in the Wild" gallery.</p>

    <h2 class="font-display text-2xl mt-8 text-bone-50">What we don't collect</h2>
    <p class="mt-3">Purchase data (there is no purchase). Behavioral tracking cookies. Third-party advertising IDs. We use privacy-respecting analytics that do not require a cookie banner.</p>

    <h2 class="font-display text-2xl mt-8 text-bone-50">Your rights</h2>
    <p class="mt-3">Email us to request a copy or deletion of your data.</p>
  </article>
</Base>
